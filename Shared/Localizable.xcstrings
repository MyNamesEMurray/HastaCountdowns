        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면의 빈 영역을 앱이 흔들릴 때까지 길게 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住主屏幕的空白区域，直到 App 开始晃动。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada un área vacía de tu pantalla de inicio hasta que las apps se muevan."
          }
        }
      }
    },
    "Touch and hold the widget, then tap Edit Widget to choose a countdown.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado el widget y toca Editar widget para elegir una cuenta regresiva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Finger auf das Widget und tippe auf „Widget bearbeiten“, um einen Countdown zu wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur le widget, puis touchez Modifier le widget pour choisir un compte à rebours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha o widget pressionado e toque em Editar Widget para escolher uma contagem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを長押しして「ウィジェットを編集」をタップし、カウントダウンを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 길게 누른 다음 위젯 편집을 탭하여 카운트다운을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住小组件，然后轻点“编辑小组件”来选择倒计时。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el widget y pulsa Editar widget para elegir una cuenta atrás."
          }
        }
      }
    },
    "Touch and hold your Lock Screen, then tap Customize.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionada la pantalla bloqueada y toca Personalizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Finger auf den Sperrbildschirm und tippe auf „Anpassen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur l'écran verrouillé, puis touchez Personnaliser."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha a Tela Bloqueada pressionada e toque em Personalizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面を長押しして、「カスタマイズ」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면을 길게 누른 다음 사용자화를 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住锁定屏幕，然后轻点“自定”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla de bloqueo y pulsa Personalizar."
          }
        }
      }
    },
