    "Help keep Hasta free for everyone, with no ads and no subscriptions.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a que Hasta siga siendo gratis para todos, sin anuncios ni suscripciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mit, dass Hasta für alle kostenlos bleibt, ohne Werbung und ohne Abos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez Hasta à rester gratuit pour tous, sans publicité ni abonnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude o Hasta a continuar grátis para todos, sem anúncios e sem assinaturas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告もサブスクもなしで、Hastaを誰でも無料で使い続けられるよう応援してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고와 구독 없이 모두가 Hasta를 무료로 쓸 수 있도록 응원해 주세요."
          }
        },
        "zh-Hans": {
