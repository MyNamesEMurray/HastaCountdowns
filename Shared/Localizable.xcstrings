    "Keep an eye on the day you're looking forward to.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No pierdas de vista el día que tanto esperas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte den Tag im Blick, auf den du dich freust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un œil sur le jour que vous attendez."
