    "Get a heads-up a week, a few days, or a day before the big day.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso una semana, unos días o un día antes del gran día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich eine Woche, ein paar Tage oder einen Tag vor dem großen Tag erinnern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez prévenu une semaine, quelques jours ou la veille du grand jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um aviso uma semana, alguns dias ou um dia antes do grande dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
