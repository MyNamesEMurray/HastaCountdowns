    "Photos stay private on your devices and iCloud, and are only used for your widgets. Choose a Live Photo to pick a different frame or make a long exposure.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se quedan privadas en tus dispositivos y en iCloud, y solo se usan para tus widgets. Elige una Live Photo para escoger otro fotograma o crear una larga exposición."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos bleiben privat auf deinen Geräten und in iCloud und werden nur für deine Widgets verwendet. Wähle ein Live Photo, um ein anderes Bild zu nehmen oder eine Langzeitbelichtung zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos restent privées sur vos appareils et dans iCloud, et ne servent qu'à vos widgets. Choisissez une Live Photo pour prendre une autre image ou créer une pose longue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos ficam privadas nos seus dispositivos e no iCloud, e são usadas só nos seus widgets. Escolha uma Live Photo para usar outro quadro ou criar uma longa exposição."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はデバイスとiCloudに非公開で保存され、ウィジェットにのみ使われます。Live Photoを選ぶと、別のフレームを使ったり長時間露光を作成したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 기기와 iCloud에 비공개로 보관되며 위젯에만 사용됩니다. Live Photo를 선택하면 다른 프레임을 고르거나 장노출 효과를 만들 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片私密保存在你的设备和 iCloud 中，仅用于你的小组件。选择实况照片可以选用其他帧或合成长曝光。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se quedan privadas en tus dispositivos y en iCloud, y solo se usan para tus widgets. Elige una Live Photo para escoger otro fotograma o crear una larga exposición."
          }
        }
      }
    },
    "Photos, typefaces, styles and more. One-time purchase.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, tipografías, estilos y más. Compra única."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, Schriften, Stile und mehr. Einmalkauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, polices, styles et plus encore. Achat unique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, fontes, estilos e mais. Compra única."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、書体、スタイルなど。買い切りです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 서체, 스타일 등. 한 번만 구매하면 끝."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、字体、样式等，一次性购买。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, tipografías, estilos y más. Compra única."
          }
        }
      }
    },
    "Pick any color, not just the ones in the palette.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cualquier color, no solo los de la paleta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle jede beliebige Farbe, nicht nur die aus der Palette."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez n'importe quelle couleur, pas seulement celles de la palette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha qualquer cor, não só as da paleta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パレット以外のどんな色も選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔레트에 없는 색상도 자유롭게 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择任意颜色，不局限于调色板。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cualquier color, no solo los de la paleta."
          }
        }
      }
    },
    "Picks years, months, weeks, days, hours, or minutes depending on how far away it is.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige años, meses, semanas, días, horas o minutos según cuánto falte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt Jahre, Monate, Wochen, Tage, Stunden oder Minuten, je nachdem, wie weit es entfernt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit années, mois, semaines, jours, heures ou minutes selon le temps restant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe anos, meses, semanas, dias, horas ou minutos conforme o tempo que falta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り時間に応じて、年・月・週・日・時間・分を自動で選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 기간에 따라 연, 월, 주, 일, 시간, 분 중에서 선택합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据距离远近，自动选择年、月、周、天、小时或分钟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige años, meses, semanas, días, horas o minutos según cuánto falte."
          }
        }
      }
    },
