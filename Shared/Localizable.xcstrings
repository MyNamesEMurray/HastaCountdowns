    "Reminders for all-day countdowns are delivered at this time.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de las cuentas regresivas de todo el día llegan a esta hora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen für ganztägige Countdowns kommen zu dieser Uhrzeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels des comptes à rebours sur la journée arrivent à cette heure."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de contagens de dia inteiro chegam neste horário."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終日のカウントダウンのリマインダーはこの時刻に届きます。"
