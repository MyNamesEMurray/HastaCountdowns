    "Hasta's iCloud data was deleted. Turn iCloud Sync on again to upload this device's countdowns.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de Hasta en iCloud se eliminaron. Vuelve a activar la sincronización con iCloud para subir las cuentas regresivas de este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Daten von Hasta wurden gelöscht. Schalte die iCloud-Synchronisierung wieder ein, um die Countdowns dieses Geräts hochzuladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données iCloud de Hasta ont été supprimées. Réactivez la synchronisation iCloud pour envoyer les comptes à rebours de cet appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do Hasta no iCloud foram apagados. Ative a sincronização com o iCloud de novo para enviar as contagens deste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HastaのiCloudデータは削除されました。このデバイスのカウントダウンをアップロードするには、iCloud同期をもう一度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta의 iCloud 데이터가 삭제되었습니다. 이 기기의 카운트다운을 업로드하려면 iCloud 동기화를 다시 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 的 iCloud 数据已被删除。重新开启 iCloud 同步即可上传此设备上的倒计时。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de Hasta en iCloud se eliminaron. Vuelve a activar la sincronización con iCloud para subir las cuentas atrás de este dispositivo."
          }
        }
      }
    },
