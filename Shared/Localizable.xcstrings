    "Put countdowns on your Home Screen, Lock Screen and in StandBy.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon cuentas regresivas en tu pantalla de inicio, en la pantalla bloqueada y en StandBy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige Countdowns auf dem Home-Bildschirm, dem Sperrbildschirm und im StandBy-Modus."
