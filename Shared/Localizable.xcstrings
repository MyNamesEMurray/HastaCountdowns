    },
    "Keeps your countdowns, reminders, and photos on all your devices through your private iCloud account.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tus cuentas regresivas, recordatorios y fotos en todos tus dispositivos mediante tu cuenta privada de iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deine Countdowns, Erinnerungen und Fotos über deinen privaten iCloud-Account auf all deinen Geräten aktuell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde vos comptes à rebours, rappels et photos sur tous vos appareils grâce à votre compte iCloud privé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém suas contagens, lembretes e fotos em todos os seus dispositivos pela sua conta privada do iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウン、リマインダー、写真を、あなたのプライベートなiCloudアカウントですべてのデバイスに同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 iCloud 계정을 통해 카운트다운, 알림, 사진을 모든 기기에 동기화합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的私人 iCloud 账户，在所有设备上同步倒计时、提醒和照片。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tus cuentas atrás, recordatorios y fotos en todos tus dispositivos mediante tu cuenta privada de iCloud."
          }
        }
      }
    },
