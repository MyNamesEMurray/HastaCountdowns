    "Blends every frame together, so moving things like water and lights turn smooth. Works best when the phone was held still.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina todos los fotogramas para que lo que se mueve, como el agua o las luces, se vea suave. Funciona mejor si el teléfono estaba quieto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überblendet alle Bilder, sodass Bewegtes wie Wasser und Lichter weich wirkt. Am besten, wenn das iPhone ruhig gehalten wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionne toutes les images pour lisser ce qui bouge, comme l'eau ou les lumières. Idéal si l'iPhone était tenu immobile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mescla todos os quadros para suavizar o que se move, como água e luzes. Funciona melhor com o iPhone parado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのフレームを重ねて、水や光など動くものをなめらかに見せます。iPhoneを動かさずに撮った写真に最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 프레임을 합쳐 물이나 불빛처럼 움직이는 대상을 부드럽게 표현합니다. iPhone을 움직이지 않고 찍었을 때 가장 좋습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有帧叠加在一起，让水流、灯光等移动的物体变得柔和。拍摄时手机保持稳定效果最佳。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina todos los fotogramas para que lo que se mueve, como el agua o las luces, se vea suave. Funciona mejor si el teléfono estaba quieto."
          }
        }
      }
    },
