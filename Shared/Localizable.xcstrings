    "Months and days, once it's at least a month away.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Meses y días, cuando falte al menos un mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monate und Tage, sobald es mindestens einen Monat entfernt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mois et jours, dès qu'il reste au moins un mois."
          }
