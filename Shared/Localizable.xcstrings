        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 종일 카운트다운의 알림은 이 시간에 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天倒计时的提醒将在此时间送达。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de las cuentas atrás de todo el día llegan a esta hora."
          }
        }
      }
    },
    "Reminders without a custom time arrive at %@, which you can change in Settings.": {
      "localizations": {
        "es-419": {
