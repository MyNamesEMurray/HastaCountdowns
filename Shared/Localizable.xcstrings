    "Trips, birthdays, concerts, the last day of school. Add as many as you like.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes, cumpleaños, conciertos, el último día de clases. Agrega todas las que quieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisen, Geburtstage, Konzerte, der letzte Schultag. Füge so viele hinzu, wie du willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyages, anniversaires, concerts, le dernier jour d'école. Ajoutez-en autant que vous voulez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Viagens, aniversários, shows, o último dia de aula. Adicione quantas quiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、誕生日、ライブ、終業式。いくつでも追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행, 생일, 콘서트, 종업식까지. 원하는 만큼 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、生日、演唱会、学期最后一天，想加多少就加多少。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes, cumpleaños, conciertos, el último día de colegio. Añade todas las que quieras."
          }
        }
      }
    },
